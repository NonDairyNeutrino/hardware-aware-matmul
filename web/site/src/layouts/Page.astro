---
import '../styles/site.css';
import StepThroughLoader from '../components/StepThroughLoader.astro';
import { chapters, extraPages, repoUrl, sectionTitles, siteSubtitle, siteTitle } from '../../site.config.mjs';

interface Props {
  title: string;
  previous?: { title: string; route: string } | null;
  next?: { title: string; route: string } | null;
  // The page has a step-through demo, so it loads the script that defines it.
  interactive?: boolean;
  // A short "where am I" label shown under the heading (chapter pages only).
  progress?: string | null;
}
const { title, previous = null, next = null, interactive = false, progress = null } = Astro.props;
const base = import.meta.env.BASE_URL;
const here = Astro.url.pathname;
// The landing page (the abstract) is headed by the site title and its subtitle; every other
// page by its own title.
const isHome = here === base;
const pageTitle = isHome ? `${siteTitle}: ${siteSubtitle}` : `${title} · ${siteTitle}`;
// Consecutive pages of one section form one navigation entry.
const entries = chapters.reduce((groups, chapter) => {
  const last = groups[groups.length - 1];
  if (last && last.section === chapter.section) last.items.push(chapter);
  else groups.push({ section: chapter.section, items: [chapter] });
  return groups;
}, [] as { section: string; items: typeof chapters }[]);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip" href="#content">Skip to the content</a>
    <header class="site-header">
      <a class="site-title" href={base}>{siteTitle}</a>
      <nav aria-label="Chapters">
        <ul>
          {entries.map((entry) =>
            entry.items.length === 1 ? (
              <li>
                <a href={base + entry.items[0].route} aria-current={here === base + entry.items[0].route ? 'page' : undefined}>
                  {entry.items[0].title}
                </a>
              </li>
            ) : (
              <li class="group">
                <span class="group-label">{sectionTitles[entry.section] ?? entry.section}</span>
                <ul>
                  {entry.items.map((chapter) => (
                    <li>
                      <a href={base + chapter.route} aria-current={here === base + chapter.route ? 'page' : undefined}>
                        {chapter.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ),
          )}
          {extraPages.map((page) => (
            <li>
              <a href={base + page.route} aria-current={here === base + page.route ? 'page' : undefined}>{page.title}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="content">
      <article>
        <h1>{isHome ? siteTitle : title}</h1>
        {progress && <p class="progress">{progress}</p>}
        {isHome && <p class="subtitle">{siteSubtitle}</p>}
        <slot />
      </article>
      <nav class="pager" aria-label="Previous and next chapter">
        {previous ? <a rel="prev" href={base + previous.route}>← {previous.title}</a> : <span />}
        {next ? <a rel="next" href={base + next.route}>{next.title} →</a> : <span />}
      </nav>
    </main>
    {interactive && <StepThroughLoader />}
    <footer class="site-footer">
      <a href={repoUrl}>Source on GitHub</a>
      <p class="licenses">
        © 2026 Nat Chapman. Code:
        <a href={`${repoUrl}/blob/trunk/LICENSE-MIT`}>MIT</a> or
        <a href={`${repoUrl}/blob/trunk/LICENSE-APACHE`}>Apache-2.0</a>. Text and videos:
        <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
      </p>
    </footer>
  </body>
</html>
